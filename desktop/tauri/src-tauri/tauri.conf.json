{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyCanvas Desktop Preview",
  "version": "0.1.0",
  "identifier": "dev.rwanbt.hycanvas.desktop.preview",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
